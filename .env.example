NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Liga o fluxo de ingestão no servidor (ADR 002). Mantenha "true" neste app.
NEXT_PUBLIC_PIPELINE_V2=true

# SOMENTE SERVIDOR: nunca use o prefixo NEXT_PUBLIC_ nesta variável (o servidor recusa subir se isso ocorrer).
# Usada para convidar alunos e reancorar grifos na publicação.
SUPABASE_SERVICE_ROLE_KEY=

# SOMENTE SERVIDOR: senha inicial dos alunos criados em Equipe › Alunos (trocada no primeiro acesso). Não versionar.
ALUNO_SENHA_PADRAO=

# Avisos no celular (Web Push). Gere o par com `npx web-push generate-vapid-keys`; sem eles, os avisos ficam desligados.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SOMENTE SERVIDOR
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:equipe@cursosduo.com.br

# Endereço público do app (só precisa mudar se o domínio mudar)
NEXT_PUBLIC_SITE_URL=https://duo-reta-final.vercel.app
